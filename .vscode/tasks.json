{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootstrap Trashcan",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/bootstrap.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Benchmark Ollama",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run-benchmark.sh"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\run-benchmark.ps1"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
